# ---------- Genel ----------
PORT=3000
# Dışarıdan erişilen adres (Instagram webhook ve cron için; Vercel'de https://uygulama-adi.vercel.app)
BASE_URL=http://localhost:3000
# Panele giriş şifresi (boş bırakılırsa şifresiz açılır – sadece yerelde!)
PANEL_PASSWORD=degistir-beni
# Oturum çerezlerini imzalamak için rastgele uzun bir metin
SESSION_SECRET=rastgele-uzun-bir-metin-yazin
BUSINESS_NAME=Anka Tasarım
OWNER_NAME=Oğuzhan Çamlıca
BUSINESS_WEBSITE=ankatasarim.com
IG_HANDLE=ankatasarim
# İlk sipariş numarası
ORDER_START_NO=1001

# ---------- Supabase (REST API) ----------
# Supabase › Project Settings › Data API › Project URL
SUPABASE_URL=
# Supabase › Project Settings › API Keys › Secret keys (sb_secret_...) — sunucuda kalır, tarayıcıya gitmez.
# (Eski projelerde "service_role" JWT anahtarı da çalışır.) Boşsa yerel JSON deposu kullanılır (data/local.json).
SUPABASE_SECRET_KEY=
# Gizli anahtar yoksa publishable (anon) anahtar da çalışır (schema.sql içindeki anon politikalarıyla):
SUPABASE_PUBLISHABLE_KEY=

# ---------- Zamanlanmış işler ----------
# /api/cron adresini koruyan gizli anahtar (rastgele uzun bir metin). cron-job.org bu adresi 30 dakikada bir çağırır.
CRON_SECRET=

# ---------- Instagram (Meta) ----------
# Meta Developers > Uygulama > Instagram > "Instagram API with Instagram Login"
IG_ACCESS_TOKEN=
IG_APP_SECRET=
# Webhook doğrulama için kendinizin belirlediği bir metin
IG_VERIFY_TOKEN=anka-webhook-dogrulama
# Graph API taban adresi
IG_API_BASE=https://graph.instagram.com/v21.0
# 24 saat penceresi dışındaki mesajlar için HUMAN_AGENT etiketiyle tekrar dene
IG_USE_HUMAN_AGENT_TAG=true

# ---------- DHL eCommerce Türkiye ----------
# manual : Gönderiyi Online Şube'de siz oluşturursunuz, takip numarasını panele girersiniz
# api    : DHL şubenizden aldığınız web servis bilgileriyle gönderi panelden oluşturulur
DHL_MODE=manual
DHL_API_BASE_URL=
DHL_API_USERNAME=
DHL_API_PASSWORD=
DHL_API_CUSTOMER_NO=
DHL_API_CREATE_PATH=/shipments
DHL_API_TRACK_PATH=/shipments/{trackingNo}
# DHL Unified Shipment Tracking API anahtarı (developer.dhl.com – ücretsiz)
DHL_TRACKING_API_KEY=
DHL_TRACKING_API_BASE=https://api-eu.dhl.com/track/shipments

# Gönderici bilgileri (DHL API modunda gönderi oluştururken kullanılır)
DHL_SENDER_NAME=Anka Tasarım
DHL_SENDER_PHONE=
DHL_SENDER_ADDRESS=
DHL_SENDER_CITY=
DHL_SENDER_DISTRICT=
DHL_SENDER_POSTAL_CODE=

# ---------- Otomasyon (kendi sunucunuzda çalıştırırken; Vercel'de cron kullanılır) ----------
AUTOMATION_ENABLED=true
# Kargo takip sorgulama sıklığı (dakika)
TRACK_POLL_MINUTES=30
# Memnuniyet sorusuna cevap gelmezse kaç gün sonra sipariş otomatik kapansın
SATISFACTION_AUTO_CLOSE_DAYS=7
# Instagram olmadan test için sahte mesaj aracı (canlıda false yapın)
ALLOW_SIMULATION=true
